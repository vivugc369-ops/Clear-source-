<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClearSource — Ethical Beauty Finder</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-snap-type: y mandatory; overflow-y: scroll; }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: #0b0a0a;
      color: #f5f0eb;
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* ============ DYNAMIC BACKGROUND ============ */
    .bg-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      background: radial-gradient(ellipse at 20% 50%, #1a1410 0%, #0d0b0a 60%, #0a0807 100%);
    }
    .bg-gradient {
      position: fixed;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      z-index: -1;
      background: radial-gradient(circle at 40% 30%, rgba(155, 191, 143, 0.08), rgba(217, 179, 130, 0.04) 50%, transparent 80%);
      animation: rotateBg 40s linear infinite;
      pointer-events: none;
    }
    @keyframes rotateBg {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* ============ FLOATING PARTICLES ============ */
    .particles {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      pointer-events: none;
      overflow: hidden;
    }
    .particle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: rgba(155, 191, 143, 0.3);
      border-radius: 50%;
      animation: floatParticle 12s infinite alternate ease-in-out;
      box-shadow: 0 0 12px rgba(155, 191, 143, 0.1);
    }
    .particle:nth-child(1) { left: 10%; top: 20%; animation-duration: 14s; width: 6px; height: 6px; }
    .particle:nth-child(2) { left: 80%; top: 15%; animation-duration: 10s; width: 3px; height: 3px; background: rgba(217, 179, 130, 0.25); }
    .particle:nth-child(3) { left: 50%; top: 70%; animation-duration: 16s; width: 5px; height: 5px; background: rgba(155, 191, 143, 0.2); }
    .particle:nth-child(4) { left: 25%; top: 85%; animation-duration: 12s; width: 4px; height: 4px; }
    .particle:nth-child(5) { left: 70%; top: 60%; animation-duration: 18s; width: 7px; height: 7px; background: rgba(217, 179, 130, 0.15); }
    .particle:nth-child(6) { left: 15%; top: 45%; animation-duration: 11s; width: 3px; height: 3px; }
    .particle:nth-child(7) { left: 90%; top: 40%; animation-duration: 15s; width: 5px; height: 5px; background: rgba(155, 191, 143, 0.15); }
    .particle:nth-child(8) { left: 35%; top: 10%; animation-duration: 13s; width: 4px; height: 4px; }
    .particle:nth-child(9) { left: 60%; top: 90%; animation-duration: 17s; width: 6px; height: 6px; background: rgba(217, 179, 130, 0.2); }
    .particle:nth-child(10) { left: 5%; top: 75%; animation-duration: 9s; width: 3px; height: 3px; }
    .particle:nth-child(11) { left: 45%; top: 35%; animation-duration: 19s; width: 5px; height: 5px; background: rgba(155, 191, 143, 0.1); }
    .particle:nth-child(12) { left: 75%; top: 25%; animation-duration: 14s; width: 4px; height: 4px; }
    @keyframes floatParticle {
      0% { transform: translate(0, 0) scale(1); opacity: 0.3; }
      100% { transform: translate(40px, -30px) scale(1.5); opacity: 0.8; }
    }

    /* ============ LEGAL BANNER ============ */
    .legal-banner {
      background: rgba(20, 18, 16, 0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(155, 191, 143, 0.1);
      color: #b5a89c;
      text-align: center;
      padding: 10px 16px;
      font-size: 0.65rem;
      letter-spacing: 0.04em;
      font-weight: 400;
      position: relative;
      z-index: 10;
    }
    .legal-banner strong { color: #d6c8b8; }

    /* ============ MARKETING HERO ============ */
    .marketing-hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 40px 20px 80px;
      position: relative;
      scroll-snap-align: start;
      background: transparent;
    }
    .marketing-hero h1 {
      font-size: 4rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.05;
      max-width: 720px;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, #f5f0eb 0%, #d6c8b8 50%, #b5a89c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .marketing-hero p {
      font-size: 1.2rem;
      opacity: 0.6;
      max-width: 480px;
      margin: 0 auto 36px;
      line-height: 1.7;
      color: #b5a89c;
    }
    .marketing-hero .cta-btn {
      background: linear-gradient(135deg, #9bbf8f, #d9b382);
      color: #0b0a0a;
      border: none;
      padding: 18px 52px;
      border-radius: 60px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 8px 40px rgba(155, 191, 143, 0.15);
      display: inline-block;
      text-decoration: none;
      position: relative;
      overflow: hidden;
    }
    .marketing-hero .cta-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 12px 56px rgba(155, 191, 143, 0.25);
    }
    .scroll-arrow {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(181, 168, 156, 0.3);
      font-size: 2.2rem;
      animation: bounceArrow 2.4s infinite;
      cursor: pointer;
      z-index: 2;
    }
    @keyframes bounceArrow {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(10px); }
    }

    /* ============ FEATURES ============ */
    .marketing-features {
      max-width: 1100px;
      margin: -20px auto 0;
      padding: 40px 20px 60px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      position: relative;
      z-index: 2;
      scroll-snap-align: start;
    }
    .feature-card {
      background: rgba(255, 252, 248, 0.04);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 24px;
      padding: 32px 24px;
      text-align: center;
      transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      transform-style: preserve-3d;
      perspective: 800px;
    }
    .feature-card:hover {
      border-color: rgba(155, 191, 143, 0.2);
      transform: translateY(-6px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }
    .feature-card .icon {
      font-size: 2.8rem;
      margin-bottom: 14px;
      display: block;
      filter: drop-shadow(0 4px 20px rgba(155, 191, 143, 0.1));
    }
    .feature-card h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #f5f0eb;
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }
    .feature-card p {
      font-size: 0.85rem;
      color: #b5a89c;
      line-height: 1.6;
      opacity: 0.8;
    }

    /* ============ TESTIMONIAL ============ */
    .marketing-testimonial {
      padding: 80px 20px;
      text-align: center;
      scroll-snap-align: start;
      background: rgba(255, 252, 248, 0.02);
      border-top: 1px solid rgba(255, 255, 255, 0.03);
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }
    .marketing-testimonial blockquote {
      max-width: 700px;
      margin: 0 auto;
      font-size: 1.6rem;
      font-weight: 500;
      color: #f5f0eb;
      line-height: 1.7;
      letter-spacing: -0.01em;
    }
    .marketing-testimonial blockquote::before {
      content: '"';
      font-size: 4rem;
      color: rgba(155, 191, 143, 0.2);
      font-weight: 800;
      display: block;
      margin-bottom: -10px;
    }
    .marketing-testimonial cite {
      display: block;
      margin-top: 16px;
      font-style: normal;
      color: #6b5e54;
      font-size: 1rem;
    }

    .marketing-cta {
      text-align: center;
      padding: 80px 20px;
      scroll-snap-align: start;
      background: rgba(255, 252, 248, 0.02);
      border-top: 1px solid rgba(255, 255, 255, 0.03);
    }
    .marketing-cta h2 {
      font-size: 2.6rem;
      font-weight: 800;
      color: #f5f0eb;
      margin-bottom: 12px;
      letter-spacing: -0.02em;
    }
    .marketing-cta p {
      color: #b5a89c;
      margin-bottom: 32px;
      font-size: 1.1rem;
      opacity: 0.7;
    }
    .marketing-cta .app-btn {
      background: linear-gradient(135deg, #9bbf8f, #d9b382);
      color: #0b0a0a;
      border: none;
      padding: 18px 60px;
      border-radius: 60px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 8px 40px rgba(155, 191, 143, 0.1);
      text-decoration: none;
      display: inline-block;
      position: relative;
      overflow: hidden;
    }
    .marketing-cta .app-btn:hover {
      transform: scale(1.04);
      box-shadow: 0 12px 56px rgba(155, 191, 143, 0.2);
    }

    /* ============ APP WRAPPER ============ */
    #clearSourceApp {
      --primary: #9bbf8f;
      --primary-dark: #7aa06e;
      --secondary: #d9b382;
      --bg: rgba(11, 10, 10, 0.6);
      --green: #9bbf8f;
      --green-bg: rgba(155, 191, 143, 0.12);
      --yellow: #d9b382;
      --yellow-bg: rgba(217, 179, 130, 0.1);
      --red: #b35c4a;
      --red-bg: rgba(179, 92, 74, 0.1);
      display: block;
      background: var(--bg);
      backdrop-filter: blur(8px);
      padding-bottom: 80px;
      scroll-snap-align: start;
    }

    /* ============ APP HEADER ============ */
    #clearSourceApp header {
      background: rgba(11, 10, 10, 0.7);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      color: white;
      padding: 20px 20px 28px;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    #clearSourceApp .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    #clearSourceApp .topbar button {
      background: rgba(255, 255, 255, 0.04);
      color: #b5a89c;
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 8px 20px;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }
    #clearSourceApp .topbar button:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #f5f0eb;
    }
    #clearSourceApp header h1 {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      background: linear-gradient(135deg, #f5f0eb, #b5a89c);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    #clearSourceApp header p {
      opacity: 0.4;
      font-size: 0.9rem;
      color: #b5a89c;
    }
    #clearSourceApp .search-bar { margin: 16px 0 0; }
    #clearSourceApp .search-bar input {
      width: 100%;
      padding: 16px 20px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 0.95rem;
      background: rgba(255, 255, 255, 0.04);
      color: #f5f0eb;
      backdrop-filter: blur(8px);
      outline: none;
      transition: all 0.3s ease;
    }
    #clearSourceApp .search-bar input:focus {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(155, 191, 143, 0.15);
    }
    #clearSourceApp .search-bar input::placeholder {
      color: rgba(181, 168, 156, 0.3);
    }

    #clearSourceApp main { padding: 20px 16px 40px; }
    #clearSourceApp .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin: 24px 0 16px;
      color: #f5f0eb;
      letter-spacing: -0.01em;
      background: rgba(255, 255, 255, 0.02);
      padding: 8px 20px;
      border-radius: 30px;
      display: inline-block;
      border: 1px solid rgba(255, 255, 255, 0.03);
    }

    /* ============ PRODUCT CARDS ============ */
    #clearSourceApp .card {
      background: rgba(255, 252, 248, 0.03);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 20px;
      display: flex;
      gap: 18px;
      align-items: center;
      margin-bottom: 14px;
      transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      cursor: pointer;
      transform-style: preserve-3d;
      perspective: 600px;
      will-change: transform;
    }
    #clearSourceApp .card:hover {
      border-color: rgba(155, 191, 143, 0.15);
      transform: translateY(-2px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    }
    #clearSourceApp .card img {
      width: 160px;
      height: 106px;
      aspect-ratio: 3 / 2;
      border-radius: 16px;
      object-fit: cover;
      background: rgba(255, 255, 255, 0.02);
      flex-shrink: 0;
      transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      cursor: zoom-in;
    }
    #clearSourceApp .card:hover img {
      transform: scale(1.05) rotate(-2deg);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    }
    #clearSourceApp .card-info { flex: 1; min-width: 0; }
    #clearSourceApp .brand {
      font-size: 0.7rem;
      text-transform: uppercase;
      color: #6b5e54;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    #clearSourceApp .name {
      font-weight: 700;
      font-size: 1rem;
      margin: 4px 0 6px;
      color: #f5f0eb;
    }
    #clearSourceApp .price {
      color: #b5a89c;
      font-size: 0.9rem;
      font-weight: 500;
    }
    #clearSourceApp .right-col {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
    }
    #clearSourceApp .score {
      font-weight: 700;
      font-size: 1rem;
      padding: 4px 16px;
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.04);
    }
    #clearSourceApp .score.high { background: var(--green-bg); color: #9bbf8f; }
    #clearSourceApp .score.mid { background: var(--yellow-bg); color: #d9b382; }
    #clearSourceApp .score.low { background: var(--red-bg); color: #b35c4a; }

    #clearSourceApp .add-btn {
      background: rgba(155, 191, 143, 0.1);
      color: #9bbf8f;
      border: 1px solid rgba(155, 191, 143, 0.1);
      padding: 6px 16px;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }
    #clearSourceApp .add-btn:hover {
      background: rgba(155, 191, 143, 0.15);
    }
    #clearSourceApp .add-btn:active { transform: scale(0.92); }
    #clearSourceApp .add-btn.added {
      background: rgba(155, 191, 143, 0.2);
      color: #9bbf8f;
      border-color: rgba(155, 191, 143, 0.2);
    }

    #clearSourceApp .empty-state {
      text-align: center;
      color: #6b5e54;
      padding: 40px 20px;
      font-weight: 500;
      background: rgba(255, 255, 255, 0.02);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.03);
    }

    .badge-best {
      background: linear-gradient(135deg, rgba(245, 176, 66, 0.2), rgba(232, 146, 42, 0.2));
      color: #f5b042;
      font-size: 0.55rem;
      font-weight: 700;
      padding: 2px 10px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      display: inline-block;
      margin-left: 8px;
      border: 1px solid rgba(245, 176, 66, 0.1);
    }
    .badge-eco {
      background: rgba(155, 191, 143, 0.15);
      color: #9bbf8f;
      font-size: 0.55rem;
      font-weight: 700;
      padding: 2px 10px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      display: inline-block;
      margin-left: 8px;
      border: 1px solid rgba(155, 191, 143, 0.1);
    }

    /* ============ DETAIL OVERLAY (INSTANT) ============ */
    #clearSourceApp .detail-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(24px);
      z-index: 1000;
      align-items: flex-end;
      animation: overlayFade 0.3s ease;
    }
    #clearSourceApp .detail-overlay.open {
      display: flex;
      animation: overlayFade 0.3s ease;
    }
    @keyframes overlayFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    #clearSourceApp .detail-sheet {
      background: rgba(20, 18, 16, 0.9);
      backdrop-filter: blur(30px);
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 32px 32px 0 0;
      padding: 28px 24px 32px;
      animation: slideUp 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      border-top: 1px solid rgba(255, 255, 255, 0.04);
    }
    @keyframes slideUp {
      from { transform: translateY(100%) scale(0.98); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    #clearSourceApp .close-btn {
      text-align: right;
      font-size: 1.8rem;
      color: #6b5e54;
      cursor: pointer;
      transition: all 0.3s ease;
      padding: 4px;
      border-radius: 50%;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      margin-left: auto;
    }
    #clearSourceApp .close-btn:hover {
      color: #f5f0eb;
      transform: rotate(90deg);
    }

    #clearSourceApp .breakdown-row {
      display: flex;
      justify-content: space-between;
      margin: 12px 0 4px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #f5f0eb;
    }
    #clearSourceApp .bar-bg {
      height: 4px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 4px;
    }
    #clearSourceApp .bar-fill {
      height: 100%;
      border-radius: 10px;
      width: 0;
      transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    #clearSourceApp .ingredient-chip {
      display: inline-block;
      background: rgba(155, 191, 143, 0.1);
      color: #9bbf8f;
      font-size: 0.75rem;
      padding: 4px 14px;
      border-radius: 30px;
      margin: 4px 4px 0 0;
      font-weight: 600;
      border: 1px solid rgba(155, 191, 143, 0.05);
    }

    /* ============ BUY BUTTON ============ */
    .buy-btn {
      display: inline-block;
      background: linear-gradient(135deg, rgba(155, 191, 143, 0.15), rgba(217, 179, 130, 0.1));
      color: #d6c8b8;
      padding: 12px 28px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.85rem;
      text-decoration: none;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.04);
      cursor: pointer;
    }
    .buy-btn:hover {
      background: linear-gradient(135deg, rgba(155, 191, 143, 0.25), rgba(217, 179, 130, 0.2));
      transform: scale(1.02);
      border-color: rgba(155, 191, 143, 0.15);
    }
    .buy-btn i { margin-right: 8px; }

    /* ============ ROUTINE ANALYZER ============ */
    .routine-analyzer {
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(8px);
      border-radius: 24px;
      padding: 24px;
      margin: 12px 0 20px;
      border: 1px solid rgba(255, 255, 255, 0.03);
    }
    .routine-analyzer h4 {
      font-size: 1rem;
      font-weight: 700;
      color: #f5f0eb;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .routine-analyzer .tip {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    }
    .routine-analyzer .tip:last-child { border-bottom: none; }
    .routine-analyzer .tip .icon { font-size: 1.2rem; flex-shrink: 0; margin-top: 2px; }
    .routine-analyzer .tip .text { font-size: 0.9rem; color: #b5a89c; }
    .routine-analyzer .tip .text strong { color: #f5f0eb; }
    .routine-analyzer .score-ring {
      display: flex;
      align-items: center;
      gap: 20px;
      background: rgba(255, 255, 255, 0.02);
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 12px;
      border: 1px solid rgba(255, 255, 255, 0.02);
    }
    .routine-analyzer .score-ring .big-num {
      font-size: 2.4rem;
      font-weight: 800;
      color: #9bbf8f;
      background: rgba(155, 191, 143, 0.05);
      padding: 8px 20px;
      border-radius: 16px;
    }
    .routine-analyzer .score-ring .label {
      font-size: 0.8rem;
      color: #6b5e54;
