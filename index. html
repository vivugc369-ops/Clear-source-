      if (list.length === 0) { analyzer.innerHTML = ''; return; }
      const categories = list.map(p => p.category);
      const hasCleanser = categories.includes('cleanser'); const hasSerum = categories.includes('serum'); const hasMoisturizer = categories.includes('moisturizer'); const hasSunscreen = categories.includes('sunscreen'); const hasToner = categories.includes('toner'); const hasMask = categories.includes('mask');
      let completeSteps = 0; if (hasCleanser) completeSteps++; if (hasSerum) completeSteps++; if (hasMoisturizer) completeSteps++; if (hasSunscreen) completeSteps++; if (hasToner) completeSteps++; if (hasMask) completeSteps++;
      const completeness = Math.round((completeSteps / 6) * 100);
      let tips = [];
      if (!hasCleanser) tips.push({ icon: '🧼', text: 'Missing a <strong>cleanser</strong>. Start with a gentle face wash.' });
      if (!hasSerum) tips.push({ icon: '🧪', text: 'Add a <strong>serum</strong> (Vitamin C or Niacinamide) for targeted treatment.' });
      if (!hasMoisturizer) tips.push({ icon: '💧', text: 'You need a <strong>moisturizer</strong> to lock in hydration.' });
      if (!hasSunscreen) tips.push({ icon: '☀️', text: 'Don\'t forget <strong>sunscreen</strong>! SPF 30+ daily is essential.' });
      if (!hasToner) tips.push({ icon: '🌸', text: 'A <strong>toner</strong> can balance your skin\'s pH.' });
      if (!hasMask) tips.push({ icon: '🌿', text: 'Try a <strong>face mask</strong> once or twice a week.' });
      const serums = list.filter(p => p.category === 'serum'); if (serums.length > 1) tips.push({ icon: '⚠️', text: `You have <strong>${serums.length} serums</strong>. Consider one AM, one PM.` });
      const exfoliants = list.filter(p => p.name.toLowerCase().includes('acid') || p.name.toLowerCase().includes('enzyme')); if (exfoliants.length > 1) tips.push({ icon: '⚡', text: `You have <strong>${exfoliants.length} exfoliating products</strong>. Don't over-exfoliate!` });
      let html = `<div class="routine-analyzer"><h4>🧠 Routine Analysis</h4><div class="score-ring"><span class="big-num">${completeness}%</span><span class="label">Routine Completeness</span></div>`;
      if (tips.length === 0) html += `<p style="color:#9bbf8f; font-weight:600; padding:8px 0;">✨ Perfect! You have a complete, balanced routine!</p>`;
      else html += tips.map(t => `<div class="tip"><span class="icon">${t.icon}</span><span class="text">${t.text}</span></div>`).join('');
      html += `</div>`; analyzer.innerHTML = html;
    }

    function renderProducts(list, targetId) {
      const c = document.getElementById(targetId); if (!c) return;
      if (list.length === 0) { c.innerHTML = '<div class="empty-state">🌿 No products found</div>'; return; }
      c.innerHTML = list.map((p, i) => `
        <div class="card" style="transition-delay:${i*0.04}s;" onclick="openDetail(${p.id})">
          <img src="${p.img}" alt="${p.name}" loading="lazy" onclick="event.stopPropagation(); openLightbox('${p.img}', '${p.name}');" />
          <div class="card-info">
            <div class="brand">${p.brand} ${p.score >= 80 ? '<span class="badge-eco">🌱 Eco</span>' : ''} ${p.score >= 90 ? '<span class="badge-best">⭐ Best</span>' : ''}</div>
            <div class="name">${p.name}</div>
            <div class="price">${p.price}</div>
          </div>
          <div class="right-col">
            <div class="score ${scoreClass(p.score)}">${p.score}</div>
            <button class="add-btn ${routine.includes(p.id)?'added':''}" onclick="event.stopPropagation();toggleRoutine(${p.id},this)">${routine.includes(p.id)?'✓':'+'}</button>
          </div>
        </div>
      `).join('');
      setTimeout(() => {
        document.querySelectorAll(`#${targetId} .card`).forEach(card => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect(); const x = e.clientX - rect.left, y = e.clientY - rect.top;
            const cx = rect.width/2, cy = rect.height/2;
            card.style.transform = `perspective(600px) rotateX(${(y-cy)/20}deg) rotateY(${(cx-x)/20}deg) scale(1.02)`;
          });
          card.addEventListener('mouseleave', () => { card.style.transform = 'perspective(600px) rotateX(0) rotateY(0) scale(1)'; });
        });
      }, 100);
    }

    function toggleRoutine(id, btn) {
      const idx = routine.indexOf(id); idx > -1 ? routine.splice(idx, 1) : routine.push(id);
      saveState();
      const onRoutine = document.getElementById('routineView').style.display === 'block';
      if (onRoutine) { renderRoutine(); } else { renderProducts(filteredProducts(), 'productList'); }
    }

    function filteredProducts() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      return products.filter(p => p.brand.toLowerCase().includes(q) || p.name.toLowerCase().includes(q));
    }

    function renderRoutine() {
      const list = products.filter(p => routine.includes(p.id));
      const avgC = document.getElementById('avgContainer');
      if (list.length === 0) { avgC.innerHTML = ''; document.getElementById('routineList').innerHTML = '<div class="empty-state">🌱 No products in routine</div>'; document.getElementById('routineAnalyzer').innerHTML = ''; return; }
      const avg = Math.round(list.reduce((s,p) => s + p.score, 0) / list.length);
      avgC.innerHTML = `<div class="avg-box"><div style="font-size:0.75rem;color:#6b5e54;font-weight:600;">ROUTINE ETHICS AVG</div><div class="num">${avg}<span style="font-size:0.9rem;color:#6b5e54;">/100</span></div><div style="font-size:0.8rem;color:#b5a89c;">${list.length} products</div></div>`;
      renderProducts(list, 'routineList');
      analyzeRoutine();
    }

    function openDetail(id) {
      const p = products.find(x => x.id === id); if (!p) return;
      const overlay = document.getElementById('detailOverlay');
      const sheet = document.getElementById('detailSheet');

      const ingredientsHTML = isPro ? `
        <div style="margin-top:16px; font-weight:700; color:#f5f0eb;">Key Ingredients <span class="pro-badge">PRO</span></div>
        <div style="margin-top:8px;">${p.ingredients.map(i => `<span class="ingredient-chip">✓ ${i}</span>`).join('')}</div>
      ` : `
        <div class="lock-overlay"><div class="lock-icon">🔒</div><p><strong>Full ingredients & parent company</strong> are Pro only</p><button class="upgrade-btn" onclick="closeDetail();showUpgrade();">Upgrade for $4.99/mo</button></div>
      `;

      const parentHTML = isPro ? `
        <div class="breakdown-row"><span>Parent Co.</span><span>${p.conglo?40:90}/100</span></div>
        <div class="bar-bg"><div class="bar-fill" data-target="${p.conglo?40:90}%" style="background:${p.conglo?'#d9b382':'#9bbf8f'}"></div></div>
        <div style="font-size:0.9rem;color:#b5a89c;margin-top:8px;">Parent: <strong style="color:#f5f0eb;">${p.parent}</strong></div>
      ` : '';

      sheet.innerHTML = `
        <div class="close-btn" onclick="closeDetail()">✕</div>
        <div style="color:#6b5e54; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em; font-weight:600;">${p.brand}</div>
        <div style="font-size:1.5rem;font-weight:700;margin:4px 0 12px;color:#f5f0eb;">${p.name}</div>
        <div style="font-size:1.1rem;margin-bottom:12px;color:#b5a89c;font-weight:500;">${p.price}</div>

        <a href="${p.buyLink}" target="_blank" rel="noopener noreferrer" class="buy-btn" style="margin-bottom:16px;display:inline-block;">
          <i class="fas fa-search"></i> View on Amazon
        </a>

        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
          ${p.cf ? '<span style="background:rgba(155,191,143,0.1);color:#9bbf8f;padding:4px 14px;border-radius:30px;font-weight:700;font-size:0.75rem;border:1px solid rgba(155,191,143,0.05);">✓ Cruelty-Free</span>' : '<span style="background:rgba(179,92,74,0.1);color:#b35c4a;padding:4px 14px;border-radius:30px;font-weight:700;font-size:0.75rem;border:1px solid rgba(179,92,74,0.05);">✗ Not CF</span>'}
          ${p.pkg ? '<span style="background:rgba(155,191,143,0.1);color:#9bbf8f;padding:4px 14px;border-radius:30px;font-weight:700;font-size:0.75rem;border:1px solid rgba(155,191,143,0.05);">Sustainable</span>' : '<span style="background:rgba(217,179,130,0.1);color:#d9b382;padding:4px 14px;border-radius:30px;font-weight:700;font-size:0.75rem;border:1px solid rgba(217,179,130,0.05);">Non-Sust</span>'}
        </div>

        <div style="font-weight:700;color:#f5f0eb;margin-top:4px;">Score Breakdown</div>
        <div class="breakdown-row"><span>Cruelty-Free</span><span>${p.cf?100:20}/100</span></div>
        <div class="bar-bg"><div class="bar-fill" data-target="${p.cf?100:20}%" style="background:${p.cf?'#9bbf8f':'#b35c4a'}"></div></div>
        <div class="breakdown-row"><span>Packaging</span><span>${p.pkg?85:40}/100</span></div>
        <div class="bar-bg"><div class="bar-fill" data-target="${p.pkg?85:40}%" style="background:${p.pkg?'#9bbf8f':'#d9b382'}"></div></div>

        ${parentHTML}
        ${ingredientsHTML}

        <button style="width:100%;margin-top:20px;padding:16px;background:linear-gradient(135deg,rgba(155,191,143,0.1),rgba(217,179,130,0.05));color:#f5f0eb;border:1px solid rgba(255,255,255,0.04);border-radius:16px;font-weight:700;cursor:pointer;transition:all 0.3s ease;position:relative;overflow:hidden;" onclick="toggleRoutine(${p.id});openDetail(${p.id});">
          ${routine.includes(p.id)?'✓ In Routine':'+ Add to Routine'}
        </button>

        <div style="font-size:0.7rem;color:#4a3f38;margin-top:12px;text-align:center;border-top:1px solid rgba(255,255,255,0.02);padding-top:12px;">
          <i class="fas fa-info-circle"></i> Opens Amazon search for this exact product.
        </div>
      `;
      overlay.classList.add('open');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          document.querySelectorAll('.bar-fill').forEach(el => {
            el.style.width = el.dataset.target;
          });
        });
      });
    }

    function closeDetail() { document.getElementById('detailOverlay').classList.remove('open'); }

    function showView(view) {
      document.getElementById('discoverView').style.display = view === 'discover' ? 'block' : 'none';
      document.getElementById('routineView').style.display = view === 'routine' ? 'block' : 'none';
      document.getElementById('navDiscover').classList.toggle('active', view === 'discover');
      document.getElementById('navRoutine').classList.toggle('active', view === 'routine');
      if (view === 'routine') renderRoutine();
    }

    function showUpgrade() {
      if (isPro) { alert("✓ You're already Pro!"); return; }
      if (confirm("🌿 Upgrade to ClearSource Pro?\n$4.99/month\n\nUnlock full ingredients & parent data")) {
        isPro = true; saveState(); document.getElementById('upgradeBtn').textContent = '✓ Pro'; alert("🎉 Welcome to Pro!");
      }
    }

    document.addEventListener('scroll', () => {
      document.querySelectorAll('#productList .card, #routineList .card').forEach((card) => {
        const rect = card.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        if (rect.top < windowHeight * 0.7 && rect.bottom > windowHeight * 0.3) {
          const img = card.querySelector('img');
          if (img) {
            const scale = 1 + (1 - (rect.top / windowHeight)) * 0.12;
            img.style.transform = `scale(${Math.min(scale, 1.12)})`;
            img.style.boxShadow = '0 20px 60px rgba(0,0,0,0.3)';
          }
        } else {
          const img = card.querySelector('img');
          if (img) { img.style.transform = 'scale(1)'; img.style.boxShadow = '0 4px 20px rgba(0,0,0,0.2)'; }
        }
      });
    });

    document.querySelectorAll('.reveal').forEach(el => {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
      }, { threshold: 0.15 });
      obs.observe(el);
    });

    document.addEventListener('click', function(e) {
      const target = e.target.closest('button, .cta-btn, .app-btn, .upgrade-btn, .add-btn, .bottom-nav button, .buy-btn');
      if (!target) return;
      const rect = target.getBoundingClientRect();
      const ripple = document.createElement('span');
      ripple.className = 'ripple';
      const size = Math.max(rect.width, rect.height);
      ripple.style.width = ripple.style.height = size + 'px';
      ripple.style.left = (e.clientX - rect.left - size/2) + 'px';
      ripple.style.top = (e.clientY - rect.top - size/2) + 'px';
      target.style.position = 'relative'; target.style.overflow = 'hidden';
      target.appendChild(ripple);
      setTimeout(() => { ripple.remove(); }, 600);
    });

    document.addEventListener('DOMContentLoaded', () => {
      renderProducts(products, 'productList');
      document.getElementById('upgradeBtn').textContent = isPro ? '✓ Pro' : '👑 Upgrade';
      document.getElementById('searchInput').addEventListener('input', () => {
        renderProducts(filteredProducts(), 'productList');
      });
    });
  </script>
</body>
</html>
